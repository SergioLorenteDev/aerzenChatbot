{
  "name": "aerzen-postventa-chatbot",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @aerzen/backend\" \"npm run dev --workspace @aerzen/widget\"",
    "build": "npm run build --workspace @aerzen/shared && npm run build --workspace @aerzen/backend && npm run build --workspace @aerzen/widget",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:manual-docs": "tsx scripts/import_manual_documents.ts",
    "import:web-docs": "tsx scripts/import_authorized_web_docs.ts",
    "generate:web-question-bank": "tsx scripts/generate_web_knowledge_question_bank.ts",
    "trace:chatbot:ai": "tsx scripts/trace_chatbot_ai.ts",
    "test:chatbot": "tsx scripts/chatbot_conversation_tests.ts",
    "test:chatbot:ai": "CHATBOT_TEST_AI_REVIEW=1 tsx scripts/chatbot_conversation_tests.ts",
    "test:chatbot:bulk": "tsx scripts/chatbot_bulk_simulation.ts",
    "test:chatbot:bulk:ai": "CHATBOT_BULK_AI_REVIEW=1 tsx scripts/chatbot_bulk_simulation.ts"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "prisma": "^6.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
