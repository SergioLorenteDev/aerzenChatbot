# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/aerzen_chatbot?schema=public"

# --- API ---
PORT=3001
# URL pública del backend. Se usa para construir los enlaces a los manuales;
# si se deja vacía se asume http://localhost:${PORT}
PUBLIC_API_BASE_URL=
# Orígenes permitidos separados por comas. Vacío = se refleja el origen de la
# petición, que es lo que necesita el widget embebido en webs de terceros.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Recuperación documental ---
VECTOR_PROVIDER=memory
VECTOR_CACHE_TTL_MS=30000
# Carpeta con los PDF de manuales: la usan el importador y GET /api/manuals/:id/file
MANUALS_DIR=fixtures/content/pdfs

# --- IA conversacional (opcional) ---
# Sin GROQ_API_KEY el backend funciona igualmente con el motor determinista.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=20000

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_DEFAULT_CHAT_IDS=

# --- Vector store externo (todavía no implementado) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Diagnóstico ---
# Añade trazas de IA (respuesta base vs. humanizada) a las respuestas del chat.
CHATBOT_TRACE_AI=false

# --- Widget (apps/widget) ---
# Backend al que llama el widget embebido. En un build de producción debe
# apuntar al backend real; si no se define se usa http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# --- Solo para el seed ---
# El seed vacía las tablas. Contra un host no local exige esta autorización.
# SEED_ALLOW_WIPE=1
